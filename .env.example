NEXT_PUBLIC_REGISTRATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com

# Dastyare Social ORG PostHog project (581705) — single analytics destination.
# One token + one host shared by the browser and the server.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Feature flag key used for the landing A/B experiment (created in PostHog UI).
POSTHOG_LANDING_FLAG_KEY=home-page-variant
# Relay server events to the Cloudflare reverse proxy (ingest.dastyare.social).
# Default true = on/send. Set to false to stop sending.
DISABLE_DEV_TEAM_PH=true

# PostHog bootstrap only (bun run bootstrap:posthog): phx_ key with admin scope.
PH_PROJECT_ID=581705
PH_PERSONAL_API_KEY="replace-with-phx-personal-api-key-with-admin-scope"
